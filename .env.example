# Copy to .env next to docker-compose.yml and fill in what you use.
# docker compose reads it; never commit .env.

# The owner page at /owner (local network only). Empty: no owner page.
DEMO_OWNER_PASSWORD=

# Visitors' feedback goes to this Discord webhook (Server settings ->
# Integrations -> Webhooks -> Copy Webhook URL). Empty: feedback is off.
DEMO_FEEDBACK_WEBHOOK=

# Let's Encrypt for this name (needs a manager image that has it: README, "HTTPS")
TLS_ACME_DOMAIN=
TLS_ACME_EMAIL=

# 1 behind Cloudflare's proxy (orange cloud): the visitor is CF-Connecting-IP,
# believed only from Cloudflare's own addresses
TRUST_CLOUDFLARE=0

# Your prepared footage folder (footage/, can_logs/). Empty: the folder
# docker-compose.yml is in.
DEMO_FOOTAGE_DIR=
